generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String
  email                       String                       @unique
  emailVerified               Boolean                      @default(false)
  image                       String?
  status                      UserStatus                   @default(PENDING_VERIFICATION)
  twoFactorEnabled            Boolean                      @default(false)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  roles                       UserRole[]
  sessions                    Session[]
  accounts                    Account[]
  twoFactors                  TwoFactor[]
  auditEvents                 AuditEvent[]                 @relation("AuditActor")
  donorProfile                DonorProfile?
  physicalDonationsRecorded   PhysicalDonation[]           @relation("PhysicalDonationClerk")
  physicalDonationInspections PhysicalDonationInspection[] @relation("PhysicalDonationInspector")
  studentProfile              Student?
  committeeMemberships        CommitteeMembership[]         @relation("CommitteeMemberUser")
  committeeAppointments       CommitteeMembership[]         @relation("CommitteeAppointer")
  committeeMembershipActions  CommitteeMembershipHistory[]  @relation("CommitteeMembershipActor")
  conflictsDeclared           CommitteeConflict[]           @relation("ConflictDeclarer")
  conflictsResolved           CommitteeConflict[]           @relation("ConflictResolver")
  goodsCollectionsRecorded    GoodsCollection[]              @relation("GoodsCollectionClerk")
  goodsCollectionsReleased    GoodsCollection[]              @relation("GoodsCollectionReleaser")

  @@map("users")
}

model Student {
  id                 String                     @id @default(uuid()) @db.Uuid
  userId             String?                    @unique @db.Uuid
  registrationNumber String                     @unique
  fullName           String
  programme          String
  school             String
  yearOfStudy        Int
  academicStatus     StudentAcademicStatus      @default(ACTIVE)
  simulationProfile  StudentSimulationProfile
  admittedAt         DateTime
  expectedGraduation DateTime
  verifiedPhone      String?
  phoneVerifiedAt    DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  user               User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  financialRecords   StudentFinancialRecord[]
  payments           StudentPayment[]
  aidRecords         StudentAidRecord[]
  financeBlocks      StudentFinanceBlock[]
  assistanceHistory  StudentAssistanceHistory[]
  applications       AssistanceApplication[]
  goodsCollections   GoodsCollection[]

  @@index([academicStatus, programme])
  @@index([simulationProfile])
  @@map("students")
}

model AcademicSemester {
  id                String                     @id @default(uuid()) @db.Uuid
  code              String                     @unique
  name              String
  academicYear      String
  startsAt          DateTime
  endsAt            DateTime
  feeDueAt          DateTime
  active            Boolean                    @default(false)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  financialRecords  StudentFinancialRecord[]
  payments          StudentPayment[]
  aidRecords        StudentAidRecord[]
  financeBlocks     StudentFinanceBlock[]
  examCalendars     ExamCalendar[]
  assistanceHistory StudentAssistanceHistory[]
  applications      AssistanceApplication[]
  goodsCollections GoodsCollection[]

  @@index([active, startsAt])
  @@map("academic_semesters")
}

model AssistanceApplication {
  id                         String                         @id @default(uuid()) @db.Uuid
  reference                  String                         @unique
  studentId                  String                         @db.Uuid
  semesterId                 String                         @db.Uuid
  type                       AssistanceApplicationType
  requestedAmount            Decimal                        @db.Decimal(18, 2)
  currency                   String                         @default("KES")
  reason                     String
  status                     AssistanceApplicationStatus    @default(DRAFT)
  financialRecordId          String                         @db.Uuid
  outstandingBalanceSnapshot Decimal                        @db.Decimal(18, 2)
  financialSnapshotAt        DateTime                       @default(now())
  version                    Int                            @default(1)
  submittedAt                DateTime?
  cancelledAt                DateTime?
  completedAt                DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  student                    Student                        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  semester                   AcademicSemester               @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  financialRecord            StudentFinancialRecord         @relation(fields: [financialRecordId], references: [id], onDelete: Restrict)
  history                    AssistanceApplicationHistory[]
  vettingRuns                VettingRun[]
  committeeConflicts         CommitteeConflict[]
  approvalRounds             ApprovalRound[]
  disbursement               Disbursement?

  @@unique([studentId, semesterId, type])
  @@index([studentId, createdAt])
  @@index([semesterId, status, createdAt])
  @@map("assistance_applications")
}

model VettingPolicy {
  id              String       @id @default(uuid()) @db.Uuid
  version         String       @unique
  name            String
  configuration   Json
  active          Boolean      @default(false)
  createdByUserId String?      @db.Uuid
  createdAt       DateTime     @default(now())
  vettingRuns     VettingRun[]

  @@index([active, createdAt])
  @@map("vetting_policies")
}

model VettingRun {
  id               String                @id @default(uuid()) @db.Uuid
  applicationId    String                @db.Uuid
  policyId         String                @db.Uuid
  status           VettingOutcome        @default(RUNNING)
  score            Decimal?              @db.Decimal(5, 2)
  inputDigest      String
  explanation      String?
  flags            Json?
  executedByUserId String?               @db.Uuid
  startedAt        DateTime              @default(now())
  completedAt      DateTime?
  application      AssistanceApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  policy           VettingPolicy         @relation(fields: [policyId], references: [id], onDelete: Restrict)
  factors          VettingFactorResult[]

  @@unique([applicationId, policyId, inputDigest])
  @@index([applicationId, startedAt])
  @@index([status, completedAt])
  @@map("vetting_runs")
}

model VettingFactorResult {
  id            String               @id @default(uuid()) @db.Uuid
  vettingRunId  String               @db.Uuid
  factor        VettingFactor
  outcome       VettingFactorOutcome
  points        Decimal              @db.Decimal(5, 2)
  maximumPoints Decimal              @db.Decimal(5, 2)
  rawValue      Json
  evidence      Json
  explanation   String
  createdAt     DateTime             @default(now())
  vettingRun    VettingRun           @relation(fields: [vettingRunId], references: [id], onDelete: Restrict)

  @@unique([vettingRunId, factor])
  @@index([factor, outcome])
  @@map("vetting_factor_results")
}

model CommitteeMembership {
  id            String                       @id @default(uuid()) @db.Uuid
  userId        String                       @db.Uuid
  seat          CommitteeSeat
  status        CommitteeMembershipStatus    @default(ACTIVE)
  appointedById String                       @db.Uuid
  appointedAt   DateTime                     @default(now())
  termStartsAt  DateTime
  termEndsAt    DateTime
  endedAt       DateTime?
  endReason     String?
  version       Int                          @default(1)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  user          User                         @relation("CommitteeMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  appointedBy   User                         @relation("CommitteeAppointer", fields: [appointedById], references: [id], onDelete: Restrict)
  history       CommitteeMembershipHistory[]
  conflicts     CommitteeConflict[]
  approvalDecisions ApprovalDecision[]

  @@index([status, termStartsAt, termEndsAt])
  @@index([userId, appointedAt])
  @@index([seat, status])
  @@map("committee_memberships")
}

model CommitteeMembershipHistory {
  id           String                    @id @default(uuid()) @db.Uuid
  membershipId String                    @db.Uuid
  fromStatus   CommitteeMembershipStatus?
  toStatus     CommitteeMembershipStatus
  actorUserId  String                    @db.Uuid
  reason       String
  version      Int
  createdAt    DateTime                  @default(now())
  membership   CommitteeMembership       @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  actor        User                      @relation("CommitteeMembershipActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([membershipId, createdAt])
  @@map("committee_membership_history")
}

model CommitteeConflict {
  id               String                  @id @default(uuid()) @db.Uuid
  membershipId     String                  @db.Uuid
  applicationId    String                  @db.Uuid
  type             CommitteeConflictType
  status           CommitteeConflictStatus @default(DECLARED)
  description      String
  declaredByUserId String                  @db.Uuid
  resolvedByUserId String?                 @db.Uuid
  resolutionNote   String?
  declaredAt       DateTime                @default(now())
  resolvedAt       DateTime?
  membership       CommitteeMembership     @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  application      AssistanceApplication   @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  declaredBy       User                    @relation("ConflictDeclarer", fields: [declaredByUserId], references: [id], onDelete: Restrict)
  resolvedBy       User?                   @relation("ConflictResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@unique([membershipId, applicationId])
  @@index([applicationId, status])
  @@map("committee_conflicts")
}

model ApprovalRound {
  id                 String              @id @default(uuid()) @db.Uuid
  applicationId      String              @db.Uuid
  sequence           Int
  applicationVersion Int
  evidenceDigest     String
  threshold          Int                 @default(2)
  status             ApprovalRoundStatus @default(OPEN)
  openedAt           DateTime            @default(now())
  closedAt           DateTime?
  invalidationReason String?
  application        AssistanceApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  decisions          ApprovalDecision[]

  @@unique([applicationId, sequence])
  @@index([applicationId, status])
  @@map("approval_rounds")
}

model ApprovalDecision {
  id           String            @id @default(uuid()) @db.Uuid
  roundId      String            @db.Uuid
  membershipId String            @db.Uuid
  decision     ApprovalDecisionType
  digest       String
  rationale    String
  signedAt     DateTime          @default(now())
  round        ApprovalRound     @relation(fields: [roundId], references: [id], onDelete: Restrict)
  membership   CommitteeMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@unique([roundId, membershipId])
  @@index([roundId, decision])
  @@map("approval_decisions")
}

model Disbursement {
  id                    String                 @id @default(uuid()) @db.Uuid
  applicationId         String                 @unique @db.Uuid
  type                  DisbursementType
  status                DisbursementStatus     @default(CREATED)
  amount                Decimal                @db.Decimal(18, 2)
  currency              String                 @default("KES")
  destination           String
  destinationReference  String
  provider              String                 @default("MPESA")
  idempotencyKey        String                 @unique
  providerRequestId     String?                @unique
  providerTransactionId String?                @unique
  attemptCount          Int                    @default(0)
  maximumAttempts       Int                    @default(3)
  failureCode           String?
  failureMessage        String?
  receiptData           Json?
  receiptHash           String?
  reconciledAt          DateTime?
  initiatedAt           DateTime?
  completedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  application           AssistanceApplication  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  attempts              DisbursementAttempt[]
  providerEvents        DisbursementProviderEvent[]

  @@index([status, createdAt])
  @@map("disbursements")
}

model DisbursementAttempt {
  id                String                    @id @default(uuid()) @db.Uuid
  disbursementId    String                    @db.Uuid
  sequence          Int
  status            DisbursementAttemptStatus @default(REQUESTED)
  requestPayload    Json
  responsePayload   Json?
  providerRequestId String?                   @unique
  failureCode       String?
  failureMessage    String?
  requestedAt       DateTime                  @default(now())
  completedAt       DateTime?
  disbursement      Disbursement              @relation(fields: [disbursementId], references: [id], onDelete: Restrict)

  @@unique([disbursementId, sequence])
  @@index([status, requestedAt])
  @@map("disbursement_attempts")
}

model DisbursementProviderEvent {
  id                 String                   @id @default(uuid()) @db.Uuid
  disbursementId     String                   @db.Uuid
  providerEventId    String                   @unique
  payloadHash        String
  rawPayload         Json
  processingStatus   ProviderEventStatus      @default(RECEIVED)
  resultCode         String?
  resultMessage      String?
  receivedAt         DateTime                 @default(now())
  processedAt        DateTime?
  disbursement       Disbursement             @relation(fields: [disbursementId], references: [id], onDelete: Restrict)

  @@index([disbursementId, receivedAt])
  @@map("disbursement_provider_events")
}

model AssistanceApplicationHistory {
  id            String                       @id @default(uuid()) @db.Uuid
  applicationId String                       @db.Uuid
  fromStatus    AssistanceApplicationStatus?
  toStatus      AssistanceApplicationStatus
  actorUserId   String?                      @db.Uuid
  reason        String?
  version       Int
  createdAt     DateTime                     @default(now())
  application   AssistanceApplication        @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([toStatus, createdAt])
  @@map("assistance_application_history")
}

model StudentFinancialRecord {
  id                 String                  @id @default(uuid()) @db.Uuid
  studentId          String                  @db.Uuid
  semesterId         String                  @db.Uuid
  invoicedAmount     Decimal                 @db.Decimal(18, 2)
  paidAmount         Decimal                 @db.Decimal(18, 2)
  aidAmount          Decimal                 @default(0) @db.Decimal(18, 2)
  outstandingBalance Decimal                 @db.Decimal(18, 2)
  currency           String                  @default("KES")
  status             StudentFinancialStatus
  snapshotAt         DateTime                @default(now())
  student            Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester           AcademicSemester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  applications       AssistanceApplication[]

  @@unique([studentId, semesterId])
  @@index([semesterId, status])
  @@map("student_financial_records")
}

model StudentPayment {
  id          String               @id @default(uuid()) @db.Uuid
  studentId   String               @db.Uuid
  semesterId  String               @db.Uuid
  reference   String               @unique
  amount      Decimal              @db.Decimal(18, 2)
  source      StudentPaymentSource
  paidAt      DateTime
  description String?
  student     Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester    AcademicSemester     @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  @@index([studentId, paidAt])
  @@index([semesterId, source])
  @@map("student_payments")
}

model ExamCalendar {
  id                String           @id @default(uuid()) @db.Uuid
  semesterId        String           @db.Uuid
  programme         String?
  examType          String
  startsAt          DateTime
  endsAt            DateTime
  clearanceDeadline DateTime
  semester          AcademicSemester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@unique([semesterId, programme, examType])
  @@index([startsAt, endsAt])
  @@map("exam_calendars")
}

model StudentAidRecord {
  id              String           @id @default(uuid()) @db.Uuid
  studentId       String           @db.Uuid
  semesterId      String           @db.Uuid
  aidType         StudentAidType
  providerName    String
  awardedAmount   Decimal          @db.Decimal(18, 2)
  disbursedAmount Decimal          @db.Decimal(18, 2)
  status          StudentAidStatus
  reference       String           @unique
  disbursedAt     DateTime?
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester        AcademicSemester @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  @@index([studentId, semesterId])
  @@index([aidType, status])
  @@map("student_aid_records")
}

model StudentFinanceBlock {
  id         String                  @id @default(uuid()) @db.Uuid
  studentId  String                  @db.Uuid
  semesterId String                  @db.Uuid
  blockType  StudentFinanceBlockType
  reason     String
  blockedAt  DateTime
  resolvedAt DateTime?
  student    Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester   AcademicSemester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  @@index([studentId, blockedAt])
  @@index([semesterId, blockType])
  @@map("student_finance_blocks")
}

model StudentAssistanceHistory {
  id             String                @id @default(uuid()) @db.Uuid
  studentId      String                @db.Uuid
  semesterId     String                @db.Uuid
  assistanceType StudentAssistanceType
  providerName   String
  amount         Decimal               @db.Decimal(18, 2)
  reference      String                @unique
  providedAt     DateTime
  student        Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester       AcademicSemester      @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  @@index([studentId, providedAt])
  @@map("student_assistance_history")
}

model DonorProfile {
  id                      String                   @id @default(uuid()) @db.Uuid
  userId                  String                   @unique @db.Uuid
  publicAlias             String                   @unique
  normalizedAlias         String                   @unique
  pendingAlias            String?
  pendingNormalizedAlias  String?                  @unique
  aliasReviewStatus       AliasReviewStatus        @default(APPROVED)
  displayNameMode         PublicNameMode           @default(ALIAS)
  publicListed            Boolean                  @default(true)
  showContributionTotal   Boolean                  @default(false)
  showRecognitionTier     Boolean                  @default(true)
  moneyContribution       Decimal                  @default(0) @db.Decimal(18, 2)
  goodsContribution       Decimal                  @default(0) @db.Decimal(18, 2)
  totalContribution       Decimal                  @default(0) @db.Decimal(18, 2)
  recognitionTier         RecognitionTierCode      @default(UNRANKED)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recognitionHistory      RecognitionHistory[]
  recognizedContributions RecognizedContribution[]
  moneyDonations          MoneyDonation[]
  physicalDonations       PhysicalDonation[]

  @@index([publicListed, recognitionTier])
  @@map("donor_profiles")
}

model MoneyDonation {
  id                 String               @id @default(uuid()) @db.Uuid
  donorProfileId     String               @db.Uuid
  amount             Decimal              @db.Decimal(18, 2)
  currency           String               @default("KES")
  channel            MoneyDonationChannel
  purpose            DonationPurpose      @default(UNRESTRICTED)
  purposeReference   String?
  status             MoneyDonationStatus  @default(CREATED)
  trackingId         String               @unique
  trackingSecretHash String
  idempotencyKey     String
  providerReference  String?              @unique
  providerReceipt    String?              @unique
  failureCode        String?
  failureReason      String?
  confirmedAt        DateTime?
  reconciledAt       DateTime?
  reversedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  donorProfile       DonorProfile         @relation(fields: [donorProfileId], references: [id], onDelete: Restrict)
  allocations        DonationAllocation[]
  receipt            DonationReceipt?
  paymentAttempts    PaymentAttempt[]

  @@unique([donorProfileId, idempotencyKey])
  @@index([donorProfileId, createdAt])
  @@index([status, createdAt])
  @@map("money_donations")
}

model PhysicalDonation {
  id                   String                       @id @default(uuid()) @db.Uuid
  clerkUserId          String                       @db.Uuid
  donorProfileId       String?                      @db.Uuid
  donorName            String
  donorPhoneEncrypted  String
  donorPhoneHash       String
  donorPhoneLast4      String
  kind                 PhysicalDonationKind
  status               PhysicalDonationStatus       @default(DRAFT)
  submissionVersion    Int                          @default(1)
  submittedAt          DateTime?
  confirmedAt          DateTime?
  rejectedAt           DateTime?
  inspectedAt          DateTime?
  finalizedAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  clerk                User                         @relation("PhysicalDonationClerk", fields: [clerkUserId], references: [id], onDelete: Restrict)
  donorProfile         DonorProfile?                @relation(fields: [donorProfileId], references: [id], onDelete: SetNull)
  lines                PhysicalDonationLine[]
  inspections          PhysicalDonationInspection[]
  cashDeposits         PhysicalCashDeposit[]
  confirmationRequests ConfirmationRequest[]

  @@index([clerkUserId, createdAt])
  @@index([donorPhoneHash, createdAt])
  @@index([status, createdAt])
  @@map("physical_donations")
}

model ConfirmationRequest {
  id                 String                 @id @default(uuid()) @db.Uuid
  targetType         ConfirmationTargetType
  targetId           String                 @db.Uuid
  physicalDonationId String?                @db.Uuid
  tokenHash          String                 @unique
  tokenPrefix        String
  status             ConfirmationStatus     @default(PENDING)
  expiresAt          DateTime
  sentAt             DateTime?
  claimedAt          DateTime?
  completedAt        DateTime?
  createdByUserId    String?                @db.Uuid
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  physicalDonation   PhysicalDonation?      @relation(fields: [physicalDonationId], references: [id], onDelete: Restrict)
  response           ConfirmationResponse?
  deliveries         ConfirmationDelivery[]

  @@index([targetType, targetId, createdAt])
  @@index([status, expiresAt])
  @@map("confirmation_requests")
}

model ConfirmationResponse {
  id                    String               @id @default(uuid()) @db.Uuid
  confirmationRequestId String               @unique @db.Uuid
  decision              ConfirmationDecision
  sourceIpHash          String?
  userAgentHash         String?
  respondedAt           DateTime             @default(now())
  request               ConfirmationRequest  @relation(fields: [confirmationRequestId], references: [id], onDelete: Restrict)

  @@map("confirmation_responses")
}

model ConfirmationDelivery {
  id                    String                     @id @default(uuid()) @db.Uuid
  confirmationRequestId String                     @db.Uuid
  provider              String
  providerMessageId     String?                    @unique
  recipientHash         String
  status                ConfirmationDeliveryStatus @default(QUEUED)
  failureReason         String?
  sentAt                DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  request               ConfirmationRequest        @relation(fields: [confirmationRequestId], references: [id], onDelete: Restrict)

  @@index([confirmationRequestId, createdAt])
  @@index([status, createdAt])
  @@map("confirmation_deliveries")
}

model PhysicalDonationLine {
  id                 String                       @id @default(uuid()) @db.Uuid
  physicalDonationId String                       @db.Uuid
  lineType           PhysicalDonationLineType
  itemName           String
  category           String?
  quantity           Int
  unit               String
  declaredValue      Decimal?                     @db.Decimal(18, 2)
  acceptedQuantity   Int?
  approvedUnitValue  Decimal?                     @db.Decimal(18, 2)
  inspectionStatus   PhysicalLineInspectionStatus @default(PENDING)
  rejectionReason    String?
  createdAt          DateTime                     @default(now())
  donation           PhysicalDonation             @relation(fields: [physicalDonationId], references: [id], onDelete: Cascade)
  inventoryBatch     InventoryBatch?

  @@index([physicalDonationId])
  @@map("physical_donation_lines")
}

model InventoryCategory {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique
  name        String
  description String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id             String            @id @default(uuid()) @db.Uuid
  categoryId     String            @db.Uuid
  sku            String            @unique
  name           String
  normalizedName String
  unit           String
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  category       InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  batches        InventoryBatch[]

  @@unique([categoryId, normalizedName, unit])
  @@index([categoryId, active])
  @@map("inventory_items")
}

model InventoryLocation {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique
  name      String
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  batches   InventoryBatch[]

  @@map("inventory_locations")
}

model InventoryBatch {
  id                           String                 @id @default(uuid()) @db.Uuid
  itemId                       String                 @db.Uuid
  locationId                   String                 @db.Uuid
  sourcePhysicalDonationLineId String                 @unique @db.Uuid
  batchNumber                  String                 @unique
  receivedQuantity             Int
  availableQuantity            Int
  reservedQuantity             Int                    @default(0)
  issuedQuantity               Int                    @default(0)
  damagedQuantity              Int                    @default(0)
  expiresAt                    DateTime?
  status                       InventoryBatchStatus   @default(AVAILABLE)
  receivedAt                   DateTime               @default(now())
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  item                         InventoryItem          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location                     InventoryLocation      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  sourcePhysicalDonationLine   PhysicalDonationLine   @relation(fields: [sourcePhysicalDonationLineId], references: [id], onDelete: Restrict)
  movements                    StockMovement[]
  reservations                 InventoryReservation[]
  countLines                   StockCountLine[]
  collectionLines              GoodsCollectionLine[]

  @@index([itemId, status, expiresAt])
  @@index([locationId, status])
  @@map("inventory_batches")
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  batchId        String            @db.Uuid
  type           StockMovementType
  quantity       Int
  availableAfter Int
  reservedAfter  Int
  referenceType  String
  referenceId    String
  reason         String?
  actorUserId    String?           @db.Uuid
