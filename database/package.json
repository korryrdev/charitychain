{
  "name": "@charitychain/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "client/index.js",
  "exports": { ".": "./client/index.js" },
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "validate": "prisma validate --schema prisma/schema.prisma",
    "format": "prisma format --schema prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed": "node prisma/seed.js",
    "seed:university": "node prisma/seedUniversityRecords.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "vitest": "^5.1.0"
  }
}
