{
  "name": "@charitychain/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "client/index.js",
  "exports": {
    ".": "./client/index.js"
  },
  "scripts": {
    "generate": "node scripts/prisma.js generate --schema prisma/schema.prisma",
    "validate": "node scripts/prisma.js validate --schema prisma/schema.prisma",
    "format": "node scripts/prisma.js format --schema prisma/schema.prisma",
    "migrate:dev": "node scripts/prisma.js migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "node scripts/prisma.js migrate deploy --schema prisma/schema.prisma",
    "seed": "node prisma/seed.js",
    "seed:university": "node prisma/seedUniversityRecords.js",
    "seed:inventory": "node prisma/seedInventory.js",
    "seed:admin": "node prisma/seedAdmin.js",
    "seed:all": "node prisma/seed.js && node prisma/seedUniversityRecords.js && node prisma/seedInventory.js && node prisma/seedAdmin.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "vitest": "^5.1.0"
  }
}
