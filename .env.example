# Application
NODE_ENV=development
APP_NAME=CharityChain
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
PORT=3000
TRUST_PROXY=false

# PostgreSQL
POSTGRES_DB=charitychain
POSTGRES_USER=charitychain
POSTGRES_PASSWORD=change-for-local-development
DATABASE_URL=postgresql://charitychain:change-for-local-development@localhost:5435/charitychain?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# Authentication
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-32-byte-key
SESSION_COOKIE_NAME=charitychain_session
SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=15
ACCOUNT_VERIFICATION_TTL_MINUTES=30
MFA_ISSUER=CharityChain
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# HTTP security and logging
CORS_ALLOWED_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
LOG_PRETTY=false

# External services
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_CALLBACK_SECRET=
MPESA_UNIVERSITY_SHORTCODE=
MPESA_UNIVERSITY_ACCOUNT=
MPESA_CALLBACK_BASE_URL=http://localhost:3000
BANK_PROVIDER=sandbox
BANK_API_KEY=
BANK_WEBHOOK_SECRET=
SMS_PROVIDER=sandbox
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080

# Blockchain
BLOCKCHAIN_NETWORK=localhost
POLYGON_RPC_URL=
BLOCKCHAIN_SERVICE_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATIONS=2

# Feature flags: real providers remain disabled until credentials are configured
FEATURE_MPESA_ENABLED=false
FEATURE_BANK_ENABLED=false
FEATURE_SMS_ENABLED=false
FEATURE_IPFS_ENABLED=true
FEATURE_BLOCKCHAIN_ANCHORING_ENABLED=false
FEATURE_BACKGROUND_JOBS_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_SECONDS=30
OUTBOX_BATCH_SIZE=25
FEATURE_PUBLIC_TRANSPARENCY_ENABLED=true
